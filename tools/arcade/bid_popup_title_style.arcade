// ============================================================================
// WRIA 1 Riparian - pop-up TITLE tag style (attribute expression)
//
// Map Viewer > BID_Scoring > Pop-ups > Attribute expressions > + Add expression
// Name it "tier tag style", then put this in the pop-up Title (replace expr0
// with the name Map Viewer assigns to this expression):
//
//   <span style="{expression/expr0}">{Priority_Tier}</span> Bank {BID}
//
// Why the split: a pop-up title renders HTML written into the title itself, but
// an expression that RETURNS HTML is escaped into plain text. So the tag markup
// lives in the title and only the style string comes from here. The style has
// no quotes or angle brackets, so escaping leaves it intact.
// ============================================================================

var t = $feature.Priority_Tier;
if (IsEmpty(t)) { return 'display:none'; }     // unscored polygons: no tag

var bg = Decode(t, 'P1', '#8E2440', 'P2', '#D2623A', 'P3', '#DDAA3E', 'P4', '#2F6FA8', '#8E9AA1');
var fg = IIf(t == 'P3' || t == 'P5', '#163A4A', '#FFFFFF');   // P3 and P5 need dark text

return 'background-color:' + bg + ';color:' + fg +
       ';font-weight:bold;padding:1px 6px;border-radius:3px;margin-right:4px';
