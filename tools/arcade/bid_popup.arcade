// ============================================================================
// WRIA 1 Riparian - bank summary for the BID_Scoring pop-up (content)
//
// Where it goes:  Map Viewer > BID_Scoring > Pop-ups > + Add content > Arcade
// Pairs with bid_popup_title_style.arcade, which styles the tier tag in the title.
//
// Reads Priority_Tier as the source of truth (it is corrected by
// tier_update_20260928.csv). The other fields are used only to say WHY the bank
// has that tier, so the sentence and the tag always agree.
//
// Every field is read through fld(), which returns null instead of erroring if
// a field is missing or renamed, so the text degrades rather than breaking.
// ============================================================================

var f = $feature;

// ---- settings ---------------------------------------------------------------
var DASHBOARD = 'https://esassoc.github.io/wria1_riparian/#bid/';

// Composite Index percentiles across the 30,850 scored banks (September 2026
// run). Refresh these four numbers if the scores are ever rerun.
var CI_P95 = 80.7;
var CI_P90 = 70.4;
var CI_P75 = 47.1;
var CI_P50 = 25.9;

// Dashboard theme colours.
var INK = '#163A4A';        // body text
var MUTED = '#7E8F96';      // labels
var ACCENT_INK = '#0B6E7E'; // Restoration Metrics text: the score values
var ACCENT = '#0F8B9F';     // link
var IMP = '#9E3B3B';        // Impairment section hue: an actual impairment

// ---- helpers ----------------------------------------------------------------
function fld(feat, name) {
  if (HasKey(feat, name)) { return feat[name]; }
  return null;
}
function txt(feat, name) {
  var v = fld(feat, name);
  if (IsEmpty(v)) { return ''; }
  return Trim(Text(v));
}
function ordinal(n) {
  var v = Round(n, 0);
  var t = v % 100;
  var suf = When(t >= 11 && t <= 13, 'th', v % 10 == 1, 'st', v % 10 == 2, 'nd',
                 v % 10 == 3, 'rd', 'th');
  return Text(v) + suf;
}
function val(s) {           // a score value, bold in the accent colour
  return '<b style="color:' + ACCENT_INK + '">' + s + '</b>';
}
function row(label, value) {
  return '<tr><td style="color:' + MUTED + ';padding:2px 8px 2px 0;vertical-align:top;' +
         'white-space:nowrap">' + label + '</td><td style="color:' + INK +
         ';padding:2px 0;vertical-align:top">' + value + '</td></tr>';
}

// ---- read the feature --------------------------------------------------------
var bid  = txt(f, 'BID');
var tier = txt(f, 'Priority_Tier');
var rp   = fld(f, 'RP_S_final');
var ap   = fld(f, 'RP_S_area_pctile');
var ci   = fld(f, 'CI_new');
var srz  = txt(f, 'SR_Zone');
var sp   = txt(f, 'salmon_species');
var name = txt(f, 'GNIS_NAME');
var size = txt(f, 'BFW_class');
var fish = txt(f, 'Fish_simple') == 'fish';
var tcat = txt(f, 'temp_impaired_cat');           // worst category on the reach
var hmz  = txt(f, 'is_hmz') == 'True';            // stored as text 'True'/'False'
var wb   = txt(f, 'PositionWaterbody') == 'Waterbody';

// ---- location ---------------------------------------------------------------
var zone = Decode(srz,
  'Lower NF Nooksack', 'Lower North Fork Nooksack',
  'Upper NF Nooksack', 'Upper North Fork Nooksack',
  'Lower MF Nooksack', 'Lower Middle Fork Nooksack',
  'Upper MF Nooksack', 'Upper Middle Fork Nooksack',
  'Lower SF Nooksack', 'Lower South Fork Nooksack',
  'Upper SF Nooksack', 'Upper South Fork Nooksack',
  srz);
var place = [];
if (name == '') { Push(place, 'Unnamed reach'); } else { Push(place, name); }
if (size != '') { Push(place, size); }
if (zone != '') { Push(place, zone); }
var where = Concatenate(place, ' · ');

var tbl = '<table style="border-collapse:collapse;font-size:12px;margin:6px 0">';

// ---- unscored polygons: say why, and stop ------------------------------------
if (IsEmpty(rp)) {
  var why = 'No scored riparian landcover falls in this bank\'s buffer zones, so it has no score.';
  if (wb) {
    // Waterbody polygons are both river channels and lakes, so say "open water".
    why = 'This polygon is open water, not riparian bank, so it is not scored. The surrounding banks carry the scores.';
  }
  return { type: 'text',
           text: '<p style="margin:0 0 4px 0;color:' + INK + '">' + why + '</p>' +
                 tbl + row('Location', where) + '</table>' };
}

// ---- salmon ------------------------------------------------------------------
var parts = [];
if (sp != '') { parts = Split(sp, ';'); }
var spp = [];
for (var i = 0; i < Count(parts); i++) { Push(spp, Trim(parts[i])); }
var n = Count(spp);
var chin = Find('Spring Chinook', sp) > -1;
var nook = Find('Nooksack', srz) > -1;

// ---- why the bank has its tier ------------------------------------------------
// Explains the stored tier using the rule's own conditions.
var reason = '';
if (tier == 'P1') {
  reason = 'is Spring Chinook water in the Nooksack with a temperature listing';
} else if (tier == 'P2') {
  reason = IIf(chin && nook, 'is Spring Chinook water in the Nooksack, without a temperature listing',
                             'is fish-bearing water with a temperature listing');
} else if (tier == 'P3') {
  reason = IIf(nook, 'is fish-bearing in the Nooksack, without Spring Chinook or a temperature listing',
                     'is Spring Chinook water outside the Nooksack with a temperature listing');
} else if (tier == 'P4') {
  reason = 'is fish-bearing outside the Nooksack, without a temperature listing';
} else if (tier == 'P5') {
  reason = IIf(n > 0, 'is not mapped as fish-accessible, so access rather than riparian condition sets its tier',
                      'has no documented fish use, so access rather than riparian condition sets its tier');
}

// ---- scores ------------------------------------------------------------------
// Word bands use the same 20-point classes as the map legend.
var rpWord = When(rp >= 80, 'very high', rp >= 60, 'high', rp >= 40, 'moderate',
                  rp >= 20, 'low', 'very low');
var ciRank = When(ci >= CI_P95, 'in the top 5% of WRIA 1 banks',
                  ci >= CI_P90, 'in the top 10% of WRIA 1 banks',
                  ci >= CI_P75, 'in the top quarter of WRIA 1 banks',
                  ci >= CI_P50, 'above the WRIA 1 median',
                  'below the WRIA 1 median');

var para = 'Restoration Priority is ' + val(Text(Round(rp, 0))) + ' (' + rpWord +
           ') and the bank is in the ' + val(ordinal(ap)) + ' percentile by area, for a ' +
           'Composite Index of ' + val(Text(Round(ci, 0))) + ', ' + ciRank + '.';
// The coloured tier tag lives in the title bar only; here the tier is plain text.
if (reason != '') { para = para + ' It is <b>' + tier + '</b> because it ' + reason + '.'; }

// ---- facts ------------------------------------------------------------------
// Temperature: say exactly what the Ecology category means. Category 2 is a
// water of concern, not an impairment, although the tier rule counts it.
var temp = 'Not listed';
if (tcat == '5') {
  temp = '<b style="color:' + IMP + '">Impaired</b>, category 5: needs a cleanup plan';
} else if (tcat == '4A') {
  temp = '<b style="color:' + IMP + '">Impaired</b>, category 4A: cleanup plan in place';
} else if (tcat == '2') {
  temp = 'Category 2: water of concern, not impaired';
}

var salmon = 'None documented';
if (n > 0) { salmon = Concatenate(spp, ', '); }

// A gradient reach can still list salmon in the distribution data (398 banks), so
// only claim "no documented fish use" when the salmon list is empty too.
var access = 'Fish-bearing (known or presumed)';
if (!fish) {
  access = IIf(n > 0, 'Gradient-accessible; not mapped as fish-bearing',
                      'Gradient-accessible, no documented fish use');
}

var facts = tbl + row('Location', where) + row('Salmon', salmon) +
            row('Temperature', temp) + row('Fish access', access);
if (hmz) { facts = facts + row('Migration', 'Within the Historic Migration Zone'); }
facts = facts + '</table>';

// ---- assemble ---------------------------------------------------------------
var html =
  '<p style="margin:0;color:' + INK + '">' + para + '</p>' +
  facts +
  '<a style="color:' + ACCENT + '" href="' + DASHBOARD + bid + '" target="_blank">' +
  'Open this bank in the dashboard</a>';

return { type: 'text', text: html };
